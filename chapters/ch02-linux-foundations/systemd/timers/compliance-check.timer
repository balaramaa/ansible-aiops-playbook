# /etc/systemd/system/compliance-check.timer
# Chapter 2, Listing 2-6 — Systemd timer with randomized delay
#
# Author : Balaramakrishna Alti
# GitHub : https://github.com/balaramaa/ansible-aiops-playbook

[Unit]
Description=Daily Compliance Check Timer

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
